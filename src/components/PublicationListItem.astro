---
import type { SerializedPublication } from "../lib/publications";
import { getPublicationActions, getPublicationVenueLabel } from "../lib/publication-ui";
import { parseAuthors } from "../lib/publications";

interface Props { publication: SerializedPublication; }
const { publication } = Astro.props;
const actions = getPublicationActions(publication);
const authors = parseAuthors(publication.authors);
---

<article class="publication-row">
  <div class="citation-venue">
    <abbr title={publication.venue}>{getPublicationVenueLabel(publication)}</abbr>
    <span class="citation-year">{publication.year}</span>
  </div>
  <div class="citation-content">
    <h3>{publication.title}</h3>
    <div class="citation-meta">
      <p class="pub-author-list">
        {authors.map((author) => (
          <span class:list={["pub-author", author.isMe && "pub-author--me"]}>{author.name}{author.equalContrib && <sup>*</sup>}{publication.alphaOrder && <sup class="pub-author__marker">α</sup>}</span>
        ))}
      </p>
      <div class="publication-links">
        {actions.map((action) => <a href={action.href} target={action.external ? "_blank" : undefined} rel={action.external ? "noreferrer" : undefined}>{action.label}</a>)}
      </div>
    </div>
    {publication.status !== "Published" && <p class="publication-status">{publication.status}</p>}
    {publication.note && <p class="publication-note">{publication.note}</p>}
  </div>
</article>
