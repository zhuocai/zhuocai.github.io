---
import PublicationListItem from "../components/PublicationListItem.astro";
import RichText from "../components/RichText.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/site";
import { cvDocument } from "../data/cv";
import { getSelectedPublications, serializePublication } from "../lib/publications";

/* HOMEPAGE EDITING GUIDE
 * This file renders the homepage at /.
 * - Search for home-fields below to edit the subject line under your name.
 * - Search for home-biography to edit the visible research sentence and the
 *   fellowship / Oxford / Tsinghua paragraph. These sentences are written here.
 * - The linked position / advisor sentence comes from positionContext in
 *   ../data/site.ts. Name, role, affiliation and contact details also come from there.
 * - Research-area titles and descriptions come from ../data/projects.ts:
 *   edit title and summary in the primary/supporting project entries.
 * - Paper titles, authors, short explanations and links come from the publication
 *   records. selected and selectedOrder choose the five homepage papers.
 *   See README.md for which records have website-local manuscript inputs.
 * - The homepage shows selected published/accepted papers; public preprints are
 *   listed only on /publications/.
 * - profile.summary below is page metadata, not the visible biography.
 *   The old hero and bio fields in site.ts are not used by this page.
 * Save edits while npm run dev is running; the local preview should update.
 */

const selectedPublications = (await getSelectedPublications()).map(serializePublication);
---

<BaseLayout title={profile.name} description={profile.summary} currentPath="/" bodyClass="home-page">
  <div class="page-shell academic-home">
    <header class="home-identity">
      <h1>{profile.name}{profile.chineseName && <span lang="zh">{profile.chineseName}</span>}</h1>
      <p class="home-fields"> Decentralized System Security · Distributed Algorithms · Blockchains </p>
    </header>

    <aside class="profile-sidebar" aria-label="Profile and contact information">
      <img class="profile-portrait" src="/images/zcaiam.jpg" alt={profile.name} width="140" height="140" />
      <div class="profile-affiliation">
        <p class="profile-role">{profile.role}</p>
        <p><a href={profile.institutionHref} target="_blank" rel="noreferrer">{profile.institution}</a></p>
      </div>
      <div class="profile-links">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        {profile.quickLinks.filter((link) => link.icon === "scholar" || link.icon === "github").map((link) => (
          <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
        ))}
        <a href={cvDocument.href} target="_blank" rel="noreferrer">Curriculum vitae · PDF</a>
      </div>
    </aside>

    <div class="home-biography">
      <p>I am a <RichText block={profile.positionContext} as="span" /> My research concerns decentralized system security and distributed algorithms, with a focus on blockchains. I study how protocols can protect transaction order, support fair randomized selection, and enable verifiable coordination among mutually distrustful participants.</p>
      <p>I am supported by the Hong Kong PhD Fellowship. Previously, I was a visiting scholar at the University of Oxford and received my B.Eng. in Automation from Tsinghua University.</p>
    </div>

    <section class="home-research" aria-labelledby="research-heading">
      <h2 id="research-heading">Research</h2>
      <div class="home-research-list">
        {profile.researchAreas.map((area) => (
          <article>
            <h3><a href={`/research/#${area.id}`}>{area.title}</a></h3>
            <p>{area.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="home-papers" aria-labelledby="publications-heading">
      <div class="home-section-heading">
        <h2 id="publications-heading">Selected publications</h2>
        <a href="/publications/">Full list</a>
      </div>
      <div class="home-publications-list">
        {selectedPublications.map((publication) => <PublicationListItem publication={publication} showSummary />)}
      </div>
      <RichText block={profile.publicationNote} class="publication-order-note" />
    </section>

  </div>
</BaseLayout>
