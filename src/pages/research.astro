---
import PublicationListItem from "../components/PublicationListItem.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects, researchIntroduction, researchVision } from "../data/projects";
import { getPublicationMap, serializePublication } from "../lib/publications";

/* RESEARCH PAGE EDITING GUIDE
 * Public research accounts, area titles, and the general vision live in
 * ../data/projects.ts. This file supplies their structure and paper links.
 * Paper descriptions are rendered once, without duplicate expandable overviews.
 * The full bibliography and technical overviews remain on /publications/.
 */

const publicationMap = await getPublicationMap();
const makeGroup = (project: (typeof projects)[number]) => ({
  ...project,
  publications: project.papers.map((paper) => {
    const publication = publicationMap.get(paper.publicationId);
    if (!publication) throw new Error(`Missing public publication ${paper.publicationId} in research area ${project.id}`);
    return { ...paper, publication: serializePublication(publication) };
  })
});
const mainGroups = projects.filter((p) => p.category !== "earlier").map(makeGroup);
const earlierGroups = projects.filter((p) => p.category === "earlier").map(makeGroup);
---

<BaseLayout title="Research" description="Research on decentralized system security and distributed algorithms for blockchains: transaction order fairness, coordination, incentives, and verification." currentPath="/research/">
  <section class="section">
    <div class="page-shell">
      <div class="section-header research-introduction">
        <h1 class="section-title">Research</h1>
        <p>{researchIntroduction}</p>
      </div>
      <nav class="research-navigation" aria-label="Research areas">
        {mainGroups.map((project) => <a href={`#${project.id}`}>{project.title}</a>)}
        <a href="#research-vision">Research vision</a>
        <a href="#prior-work">Earlier work</a>
      </nav>
    </div>
  </section>

  {mainGroups.map((project) => (
    <section class="section research-area" id={project.id}>
      <div class="page-shell">
        <div class="section-header">
          {project.category === "primary" && <p class="eyebrow">Main research direction</p>}
          <h2 class="section-title">{project.title}</h2>
          <div class="research-narrative">
            {project.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
        <div class="research-papers">
          {project.publications.map(({ publication, description, anchorId }) => (
            <div id={anchorId}>
              <PublicationListItem publication={publication} description={description} anchorId={`paper-${publication.id}`} />
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section research-area" id="research-vision">
    <div class="page-shell">
      <div class="section-header research-narrative">
        <h2 class="section-title">Research vision</h2>
        <p>{researchVision}</p>
        <p><a href="/publications/">Browse all publications and public preprints</a></p>
      </div>
    </div>
  </section>

  <section class="section research-area" id="prior-work">
    <div class="page-shell">
      {earlierGroups.map((project) => (
        <div id={project.id}>
          <div class="section-header research-narrative">
            <h2 class="section-title">{project.title}</h2>
            {project.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          {project.publications.map(({ publication }) => (
            <PublicationListItem publication={publication} anchorId={`paper-${publication.id}`} />
          ))}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
