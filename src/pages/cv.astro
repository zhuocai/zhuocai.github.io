---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/site";
import { cvDocument } from "../data/cv";

const updatedLabel = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC"
}).format(new Date(`${cvDocument.updated}T00:00:00Z`));
---

<BaseLayout title="CV" description={`Curriculum vitae and academic summary for ${profile.name}.`} currentPath="/cv/">
  <section class="section">
    <div class="page-shell">
      <div class="section-header" data-reveal>
        <p class="eyebrow">Curriculum vitae</p>
        <h1 class="section-title">Curriculum vitae</h1>
        <p class="section-copy">Academic background, research highlights, teaching, and service.</p>
        <div class="cta-actions">
          <a class="button" href={cvDocument.href} target="_blank" rel="noreferrer">Open PDF</a>
          <a class="button button--ghost" href={cvDocument.href} download={cvDocument.downloadName}>Download CV</a>
        </div>
        <p class="cv-document-meta">English · {cvDocument.pageCount} pages · Updated <time datetime={cvDocument.updated}>{updatedLabel}</time></p>
      </div>

      <div class="cv-summary">
        <article class="cv-panel" data-reveal>
          <h2 class="snapshot-card__label">Current position</h2>
          <h3>PhD Candidate in Computer Science and Engineering</h3>
          <p><a href={profile.institutionHref} target="_blank" rel="noreferrer">{profile.institution}</a></p>
          <p>Expected graduation: {cvDocument.expectedGraduation}.</p>
        </article>

        <article class="cv-panel" data-reveal>
          <h2 class="snapshot-card__label">Research focus</h2>
          <p>Decentralized system security and distributed algorithms, with a focus on blockchains. My work develops guarantees for transaction order fairness, coordination, and participation through protocol design, cryptography, incentives, and verification.</p>
        </article>
      </div>

      <div class="grid-two">
        <article class="cv-panel" data-reveal>
          <h2 class="snapshot-card__label">Research highlights</h2>
          <ul>
            {profile.cvHighlights.map((item) => <li>{item}</li>)}
          </ul>
        </article>

        {profile.service.length > 0 && (
          <article class="cv-panel" data-reveal>
            <h2 class="snapshot-card__label">Academic service</h2>
            <ul>
              {profile.service.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        )}
      </div>

      <article class="cv-panel" data-reveal>
        <h2 class="snapshot-card__label">Education and research experience</h2>
        <ul class="cv-timeline">
          {profile.education.map((entry) => (
            <li class="cv-timeline__entry">
              <span class="cv-timeline__period">{entry.period}</span>
              <div>
                <strong>
                  {entry.institutionHref
                    ? <a class="text-link" href={entry.institutionHref} target="_blank" rel="noreferrer">{entry.institution}</a>
                    : entry.institution
                  }
                </strong>
                <span class="cv-timeline__location">, {entry.location}</span>
                <p class="cv-timeline__degree">{entry.degree}</p>
                {entry.detail && <p class="cv-timeline__detail">{entry.detail}</p>}
              </div>
            </li>
          ))}
        </ul>
      </article>

      <article class="cv-panel" data-reveal>
        <h2 class="snapshot-card__label">Honors and awards</h2>
        <ul class="cv-timeline">
          {profile.awardsAndAchievements.map((award) => (
            <li class="cv-timeline__entry">
              <span class="cv-timeline__period">{award.year}</span>
              <div>
                <strong>{award.title}</strong>
                {award.detail && <p class="cv-timeline__detail">{award.detail}</p>}
              </div>
            </li>
          ))}
        </ul>
      </article>

      <article class="cv-panel" data-reveal>
        <h2 class="snapshot-card__label">Teaching</h2>
        <ul class="cv-timeline">
          {profile.teaching.map((entry) => (
            <li class="cv-timeline__entry">
              <span class="cv-timeline__period">{entry.period}</span>
              <div>
                <span class:list={["cv-teaching__role", entry.role === "Instructor" && "cv-teaching__role--instructor"]}>{entry.role}</span>
                <p class="cv-timeline__degree">{entry.course}</p>
                <p class="cv-timeline__detail">
                  {entry.institutionHref
                    ? <a class="text-link" href={entry.institutionHref} target="_blank" rel="noreferrer">{entry.institution}</a>
                    : entry.institution
                  }
                </p>
              </div>
            </li>
          ))}
        </ul>
      </article>

    </div>
  </section>
</BaseLayout>

<style>
  .cv-document-meta {
    margin-top: .75rem;
    color: var(--text-soft);
    font: .875rem/1.6 var(--font-ui);
  }

</style>
