---
import RichText from "../components/RichText.astro";
import PublicationsExplorer from "../components/react/PublicationsExplorer";
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/site";
import { getAllPublications, serializePublication } from "../lib/publications";

const publications = (await getAllPublications()).map(serializePublication);
---

<BaseLayout
  title="Publications"
  description="Published and accepted papers and public preprints on decentralized system security, distributed algorithms, and blockchains."
  currentPath="/publications/"
>
  <section class="section">
    <div class="page-shell">
      <div class="section-header" data-reveal>
        <h1 class="section-title">Publications</h1>
        <div class="section-copy section-copy--stack">
          <RichText block={profile.publicationNote} class="text-block" />
          <p>Published and accepted papers are listed separately from public preprints. Search by title, author, venue, or keyword, or filter by research area.</p>
        </div>
      </div>

      <div data-reveal>
        <PublicationsExplorer client:load publications={publications} />
      </div>
    </div>
  </section>
</BaseLayout>
