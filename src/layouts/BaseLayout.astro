---
import { profile } from "../data/site";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  bodyClass?: string;
}

const {
  title = profile.name,
  description = profile.summary,
  currentPath = "/",
  bodyClass = ""
} = Astro.props;

const pageTitle = title === profile.name ? title : `${title} | ${profile.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171b21" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const system = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        let stored;
        try { stored = localStorage.getItem("zhuocai-theme"); } catch {}
        document.documentElement.dataset.theme = stored === "dark" || stored === "light" ? stored : system;
      })();
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-shell">
      <SiteHeader currentPath={currentPath} />
      <main id="content">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <script is:inline>
      const initializeChrome = () => {
        const root = document.documentElement;
        const themeToggleButtons = document.querySelectorAll("[data-theme-toggle]");

        const syncThemeLabel = () => {
          const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
          themeToggleButtons.forEach((button) => {
            button.setAttribute("aria-pressed", String(root.dataset.theme === "dark"));
            button.setAttribute("aria-label", `Switch to ${nextTheme} theme`);
            const label = button.querySelector("[data-theme-label]");
            if (label) {
              label.textContent = nextTheme === "dark" ? "Dark" : "Light";
            }
          });
        };

        themeToggleButtons.forEach((button) => {
          if (button.dataset.bound === "true") {
            return;
          }

          button.dataset.bound = "true";
          button.addEventListener("click", () => {
            root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
            try { localStorage.setItem("zhuocai-theme", root.dataset.theme); } catch {}
            syncThemeLabel();
          });
        });

        syncThemeLabel();

      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initializeChrome, { once: true });
      } else {
        initializeChrome();
      }
    </script>
  </body>
</html>
